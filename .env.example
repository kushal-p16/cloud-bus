# SmartBus AI — Environment Configuration
# Copy this file to .env for local development.
# In production set these as environment variables in Vercel / AWS / Docker.

PROJECT_NAME="SmartBus AI"
VERSION="1.0.0"
ENVIRONMENT="development"
API_V1_STR="/api"

# ── Security ────────────────────────────────────────────────────────────────
# Generate a strong secret with: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER commit a real value here — override via env var in CI/CD and hosting.
SECRET_KEY="REPLACE_WITH_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ─────────────────────────────────────────────────────────────────
# Local SQLite (development only — NOT suitable for Vercel serverless):
DATABASE_URL="sqlite:///./smartbus.db"
# PostgreSQL (production — Neon, Supabase, Amazon RDS, etc.):
# DATABASE_URL="postgresql+psycopg2://user:password@host:5432/smartbus_db"

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated JSON array of allowed origins.
# Development defaults are set in code; override here for production:
# BACKEND_CORS_ORIGINS='["https://smartbus-frontend.vercel.app"]'

# ── AWS (optional, only if deploying to AWS) ──────────────────────────────────
# AWS_REGION="ap-south-1"
# AWS_S3_BUCKET_NAME="smartbus-ai-artifacts-prod"
