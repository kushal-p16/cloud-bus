# SmartBus AI Environment Configuration
PROJECT_NAME="SmartBus AI"
VERSION="1.0.0"
ENVIRONMENT="development"
API_V1_STR="/api"

# Security & JWT (Replace with strong 32+ char secret in production)
SECRET_KEY="smartbus-cloud-computing-jwt-production-secret-mysuru-sdg11"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite Fallback:
DATABASE_URL="sqlite:///./smartbus.db"
# PostgreSQL Cloud Production URL (Amazon RDS):
# DATABASE_URL="postgresql://smartbus_admin:YourStrongPassword@smartbus-rds.c123456789.ap-south-1.rds.amazonaws.com:5432/smartbus_db"

# CORS Allowed Origins (Comma separated or *)
BACKEND_CORS_ORIGINS='["http://localhost:5173", "http://localhost:3000", "*"]'

# AWS Cloud Deployment Settings (Optional for AWS CLI / App Runner)
AWS_REGION="ap-south-1"
AWS_S3_BUCKET_NAME="smartbus-ai-artifacts-prod"
